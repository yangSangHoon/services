{
  "name": "찰나 — 순간 기록장",
  "short_name": "찰나",
  "description": "웃음 터진 그 순간, 10초 만에 남겨두는 추억 기록장",
  "lang": "ko",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf6ee",
  "theme_color": "#fbf6ee",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "바로 남기기", "url": "./?source=shortcut", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "보관함", "url": "./?archive", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "photo", "accept": ["image/*"] }]
    }
  }
}
